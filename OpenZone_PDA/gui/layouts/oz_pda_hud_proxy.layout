// Hand-written (proportional layout, not generated): colours are the palette of ui/tokens.json in openzone-core, read through this repo's [build] tokens, kept by hand.
// Прокси однієї панелі HUD у редакторі: рамка з підписом, яку тягнуть
// мишею. Розмір і позицію задає скрипт з живої панелі.

FrameWidgetClass OZ_HudProxy {
 visible 1
 position 0 0
 size 0.1 0.05
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 5
 {
  PanelWidgetClass ProxyBg {
   visible 1
   ignorepointer 1
   color 0.135 0.18 0.225 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style rover_sim_colorable
  }

  PanelWidgetClass ProxyMark {
   visible 1
   ignorepointer 1
   color 0.31 0.71 0.91 1
   position 0 0
   size 3 1
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
   priority 2
   style rover_sim_colorable
  }

  // ВІДСТУП ЧАСТКОЮ, А НЕ ПІКСЕЛЯМИ. Було `position 8 0` (точні одиниці) при
  // `size 1 1` (частка від рамки): віджет лишався завширшки з рамку й вилазив
  // за неї рівно на ці 8 одиниць при БУДЬ-ЯКОМУ її розмірі -- «заповнити з
  // відступом» так не робиться (gui-layouts §24). Скрипт тут не допоміг би:
  // рамку він розмірює частками екрана, а піксельний SetSize вимагав би зробити
  // підпис exact-size, і в галереї сама розкладка все одно лишалась би битою.
  // Тепер відступ -- 4 % рамки з кожного боку: підпис ліворуч, вліз завжди.
  TextWidgetClass ProxyLabel {
   visible 1
   ignorepointer 1
   position 0.04 0
   size 0.92 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   color 0.9 0.93 0.95 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 13
   "text halign" left
   "text valign" center
   priority 2
  }
 }
}
